# Backend and agent: keep this root .env local and never commit it.
DATABASE_PATH=data/employees.db
CORS_ORIGINS=http://localhost:5173
# Select one: openai, groq, grok, anthropic, bedrock, ollama, or vllm.
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
# For hosted providers, set this generic key or the selected provider-specific key below.
LLM_API_KEY=
# Optional: overrides the selected provider's default endpoint. Required for custom vLLM servers.
LLM_BASE_URL=
# Optional provider-specific keys. Leave unrelated values blank.
OPENAI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
# Ollama and unauthenticated vLLM servers work without a key. Set one only when required by your server.
OLLAMA_API_KEY=
VLLM_API_KEY=
# Bedrock uses the standard AWS credential chain or this named AWS profile.
AWS_REGION=us-east-1
AWS_PROFILE=
# Applies to native Anthropic and Bedrock responses.
LLM_MAX_TOKENS=1024
AGENT_BACKEND_URL=http://127.0.0.1:8000/agent
